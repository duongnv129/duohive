---
source: crates/duohive-cli/src/claude.rs
expression: cmd
---
program: claude
args:
  - "--append-system-prompt"
  - "# Org\n\nIf you are asked for the sentinel, reply HIVE-SENTINEL."
  - "--settings"
  - /data/duohive/run/squad-1/settings.json
env: []
cwd: /home/u/code/payments
files:
  - path: /data/duohive/run/squad-1/settings.json
    contents: "{\n  \"hooks\": {\n    \"PermissionRequest\": [\n      {\n        \"hooks\": [\n          {\n            \"command\": \"'/usr/local/bin/duohive' hook 'squad-1' needs-input\",\n            \"type\": \"command\"\n          }\n        ],\n        \"matcher\": \"\"\n      }\n    ],\n    \"PostToolUse\": [\n      {\n        \"hooks\": [\n          {\n            \"command\": \"'/usr/local/bin/duohive' hook 'squad-1' busy\",\n            \"type\": \"command\"\n          }\n        ],\n        \"matcher\": \"\"\n      }\n    ],\n    \"PreToolUse\": [\n      {\n        \"hooks\": [\n          {\n            \"command\": \"'/usr/local/bin/duohive' hook 'squad-1' busy\",\n            \"type\": \"command\"\n          }\n        ],\n        \"matcher\": \"\"\n      }\n    ],\n    \"SessionEnd\": [\n      {\n        \"hooks\": [\n          {\n            \"command\": \"'/usr/local/bin/duohive' hook 'squad-1' session-end\",\n            \"type\": \"command\"\n          }\n        ],\n        \"matcher\": \"\"\n      }\n    ],\n    \"SessionStart\": [\n      {\n        \"hooks\": [\n          {\n            \"command\": \"'/usr/local/bin/duohive' hook 'squad-1' session-start\",\n            \"type\": \"command\"\n          }\n        ],\n        \"matcher\": \"\"\n      }\n    ],\n    \"Stop\": [\n      {\n        \"hooks\": [\n          {\n            \"command\": \"'/usr/local/bin/duohive' hook 'squad-1' turn-end\",\n            \"type\": \"command\"\n          }\n        ],\n        \"matcher\": \"\"\n      }\n    ],\n    \"StopFailure\": [\n      {\n        \"hooks\": [\n          {\n            \"command\": \"'/usr/local/bin/duohive' hook 'squad-1' turn-end\",\n            \"type\": \"command\"\n          }\n        ],\n        \"matcher\": \"\"\n      }\n    ],\n    \"UserPromptSubmit\": [\n      {\n        \"hooks\": [\n          {\n            \"command\": \"'/usr/local/bin/duohive' hook 'squad-1' busy\",\n            \"type\": \"command\"\n          }\n        ],\n        \"matcher\": \"\"\n      }\n    ]\n  }\n}"
