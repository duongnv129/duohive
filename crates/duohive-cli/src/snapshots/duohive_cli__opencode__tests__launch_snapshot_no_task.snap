---
source: crates/duohive-cli/src/opencode_tests.rs
expression: for_snapshot(cmd)
---
program: opencode
args:
  - "--standalone"
env:
  - - OPENCODE_CONFIG
    - /data/duohive/run/squad-1/opencode.json
  - - DUOHIVE_HOOK_EXE
    - /usr/local/bin/duohive
  - - DUOHIVE_HOOK_AGENT
    - squad-1
cwd: /home/u/code/payments
files:
  - path: /data/duohive/run/squad-1/instructions.md
    contents: "# Org\n\nIf you are asked for the sentinel, reply HIVE-SENTINEL."
  - path: /data/duohive/run/squad-1/opencode.json
    contents: "{\n  \"default_agent\": \"build\",\n  \"mcp\": {\n    \"duohive\": {\n      \"command\": [\n        \"/usr/local/bin/duohive\",\n        \"mcp\"\n      ],\n      \"enabled\": true,\n      \"type\": \"local\"\n    }\n  },\n  \"plugins\": [\n    {\n      \"options\": {\n        \"instructions\": \"/data/duohive/run/squad-1/instructions.md\"\n      },\n      \"package\": \"file:///data/duohive/run/squad-1/opencode-plugin\"\n    }\n  ]\n}"
  - path: /data/duohive/run/squad-1/opencode-plugin/index.js
    contents: "<src/assets/opencode-plugin/index.js>"
